# ==============================================
# DATABASE
# ==============================================
# URL koneksi PostgreSQL dari Supabase
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ==============================================
# SUPABASE
# ==============================================
# Dapatkan dari: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Untuk operasi storage server-side (upload dan penghapusan foto)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Integrasi AI dan transkripsi (server-side only)
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

# ==============================================
# AUTENTIKASI JWT
# ==============================================
# Secret key minimal 32 karakter, acak dan aman
# Generate: openssl rand -base64 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ==============================================
# APLIKASI
# ==============================================
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Model AI dapat diganti melalui environment tanpa mengubah source code.
GEMINI_MODEL=gemini-3.6-flash

# Seed admin (wajib hanya saat menjalankan pnpm db:seed)
SEED_ADMIN_NIP=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin IT
SEED_ADMIN_AGENCY=BAPENDA PROV. SULTRA
